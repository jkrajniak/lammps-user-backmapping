# Standalone atomistic reference for dodecane (500 molecules, paper-grade)
# GROMOS united-atom force field (CH3/CH2)
# Output: rdf_reference_long.dat — 5 blocks of 200 ps each, 1 ns total
#
# Independent of backmapping. Builds from a lattice in an expanded box,
# compresses with fix deform, equilibrates, runs 1 ns NVT production.
#
# Prerequisites:
#   uv run build_at_reference.py --gro dodecane_single.gro \
#       --output dodecane_at_ref.data --n-mol 500

units           real
atom_style      full
boundary        p p p

pair_style      lj/cut 14.00
pair_modify     shift yes
bond_style      harmonic
angle_style     harmonic

read_data       dodecane_at_ref.data

special_bonds   lj 0.0 0.0 0.0

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes

thermo          5000
thermo_style    custom step temp pe ke etotal press density vol

# --- Phase A: NVT high-T randomisation in expanded box (10 ps) ------------
timestep        0.5
fix             integrate all nvt temp 600.0 600.0 100.0
run             20000

# --- Phase B: compress to target density via fix deform (50 ps) -----------
unfix           integrate
fix             integrate all nvt temp 500.0 500.0 100.0
fix             shrink all deform 1 x final 0.0 57.5376 y final 0.0 57.5376 z final 0.0 57.5376 units box
run             100000
unfix           shrink

# --- Phase C: NPT relax pressure, anneal 500 K -> 298 K (100 ps) ----------
unfix           integrate
timestep        1.0
fix             integrate all npt temp 500.0 298.0 100.0 iso 1.0 1.0 1000.0
run             100000

# --- Phase D: NVT equilibration at 298 K (100 ps) -------------------------
unfix           integrate
fix             integrate all nvt temp 298.0 298.0 100.0
run             100000

# --- Phase E: production 1 ns with RDF averaging (5 x 200 ps blocks) ------
# CH3-CH3 (1-1), CH3-CH2 (1-2), CH2-CH2 (2-2)
compute         rdf_ref all rdf 200 1 1 1 2 2 2
# Match in.dodecane_at_long: Nevery=100, Nrepeat=2000, Nfreq=200000.
fix             rdf_out all ave/time 100 2000 200000 c_rdf_ref[*] file rdf_reference_long.dat mode vector

run             1000000

unfix           rdf_out
unfix           integrate
write_data      dodecane_at_equil_long.data
