angle_coeff 45 backmap/table cg table_a1.table ENTRY

dihedral_style hybrid ryckaert harmonic backmap/ryckaert backmap/harmonic backmap/table linear 1000
dihedral_coeff 1 ryckaert 0.150000 -0.450000 0.000000 0.600001 0.000000 -0.000000
dihedral_coeff 2 ryckaert -0.105999 -0.916002 0.173999 0.984000 0.000000 -0.000000
dihedral_coeff 3 ryckaert 0.233999 -0.701999 0.000000 0.936000 0.000000 -0.000000
dihedral_coeff 4 ryckaert 0.225000 -0.675001 0.000000 0.900001 0.000000 -0.000000
dihedral_coeff 5 ryckaert 4.533005 4.533005 0.000000 -0.000000 0.000000 -0.000000
dihedral_coeff 6 ryckaert 7.250008 -0.000000 -7.250008 -0.000000 0.000000 -0.000000
dihedral_coeff 7 harmonic 1.100001 -1 2
dihedral_coeff 8 ryckaert 5.000006 -0.000000 -5.000006 -0.000000 0.000000 -0.000000
dihedral_coeff 9 backmap/table cg table_d0.table ENTRY
dihedral_coeff 10 backmap/table cg table_d1.table ENTRY
dihedral_coeff 11 backmap/ryckaert at 2.100002 -0.000000 -2.100002 -0.000000 0.000000 -0.000000
dihedral_coeff 12 backmap/harmonic at 10.500012 -1 2
dihedral_coeff 13 backmap/ryckaert at 7.250008 -0.000000 -7.250008 -0.000000 0.000000 -0.000000
dihedral_coeff 14 backmap/harmonic at 1.100001 -1 2
dihedral_coeff 15 backmap/ryckaert at 7.000008 2.000002 -5.000006 -0.000000 0.000000 -0.000000

special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

group at_atoms type 2 3 4 5 8 9 10 12 13 15 17 18
group cg_atoms type 1 6 7 11 14 16

neigh_modify delay 0 every 1 check yes

# Bakery velocity: one Maxwell-Boltzmann draw per bead, shared by CG+AT
# (regenerate with pet_bakery_velocities.py pet.data pet_vel.bakery.dump)
read_dump pet_vel.bakery.dump 0 vx vy vz box no replace yes format native

fix integrate_at at_atoms nve
fix therm_at at_atoms langevin 298.0 298.0 33.333333 48279

fix bm all backmap cg_type 1 6 7 11 14 16 alpha 0.0001 lambda0 0.0 nonuniform no
fix pairs all backmap/pairs at file pairs.dat cut 12.000000
fix cap all backmap/capforce 1195.0300
# SHAKE placed AFTER bm/pairs/cap: must see the complete final force
# (post CG->AT redistribution + CapForce clipping), not an incomplete
# picture -- established finding, 20260723_pet-lambda0-shake-fix-order.md
fix shake_xh at_atoms shake 0.0001 20 0 b 2 3 5 9 11 12 13
fix_modify bm active no

compute at_temp at_atoms temp
compute cg_temp cg_atoms temp

thermo 100
thermo_style custom step temp c_at_temp c_cg_temp pe epair ebond eangle edihed f_bm f_cap f_cap[2]
thermo_modify colname f_bm lambda
thermo_modify colname f_cap ncapped
thermo_modify colname f_cap[2] Fobs
thermo_modify temp at_temp
thermo_modify lost ignore

dump traj all custom 1000 dump.backmap id mol type x y z f_bm
dump_modify traj sort id

timestep 1.00

# --- Stage 1: lambda=0 equilibration (no Phase 0 minimize) ---
run ${eq_steps}
print "EQ done step=$(step) T=$(c_at_temp) Ebond=$(ebond) Eangle=$(eangle)"

# --- Stage 2: lambda ramp 0 -> 1 (continuous, no frozen-CG break) ---
fix_modify bm active yes
run ${ramp_steps}
print "RAMP done step=$(step) T=$(c_at_temp) lambda=$(f_bm) Ebond=$(ebond) Eangle=$(eangle)"

# --- Stage 3: lambda=1 production ---
run ${prod_steps}
print "PRODUCTION done step=$(step) T=$(c_at_temp) lambda=$(f_bm) Ebond=$(ebond) Eangle=$(eangle)"

write_data pet_hybrid.data
