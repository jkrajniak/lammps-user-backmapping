# LAMMPS input for backmapping — 3-phase protocol
# Reference: Krajniak et al., JCTC 2016, DOI: 10.1021/acs.jctc.6b00595
#            Krajniak, Zhang et al., JCC 2018, DOI: 10.1002/jcc.25129
#
# Phase 0: Relax AT overlaps with CG frozen (small dt, nve/limit)
# Phase 1: Lambda ramp 0 → 1 with NVT (medium dt)
# Phase 2: Short NVT equilibration at full lambda (production dt)
#
# After completion, run extract_at_frame.py to get a pure AT data file,
# then run in.dodecane_at for RDF collection.

units real
atom_style full
boundary p p p

read_data dodecane.data

pair_style backmap 14.00 lj/cut/coul/cut 14.00 9.00 14.00 table linear 1000
pair_coeff 1 1 cg table_A_A.table ENTRY
pair_coeff 1 2 cg table_A_B.table ENTRY
pair_coeff 1 3 none
pair_coeff 1 4 none
pair_coeff 2 2 cg table_B_B.table ENTRY
pair_coeff 2 3 none
pair_coeff 2 4 none
pair_coeff 3 3 atomistic 0.207266 3.748000
pair_coeff 3 4 atomistic 0.156387 3.826500
pair_coeff 4 4 atomistic 0.117997 3.905000

bond_style hybrid harmonic backmap/harmonic backmap/table linear 1000
bond_coeff 1 harmonic 800.000883 1.530000
bond_coeff 2 backmap/table cg table_b1.table ENTRY
bond_coeff 3 backmap/table cg table_b1.table ENTRY
bond_coeff 4 backmap/harmonic at 800.000883 1.530000

angle_style backmap/harmonic
angle_coeff 1 at 126.673180 111.0000

special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

group at_atoms type 3 4
group cg_atoms type 1 2

neigh_modify delay 0 every 1 check yes

fix bm all backmap cg_type 1 2 alpha 0.0001 lambda0 0.0

compute at_temp at_atoms temp

thermo 2000
thermo_style custom step temp pe ke etotal press f_bm
thermo_modify colname f_bm lambda
thermo_modify temp at_temp

dump traj all custom 5000 dump.backmap id mol type x y z f_bm
dump_modify traj sort id

# === Phase 0: Minimize AT overlaps ===
fix freeze cg_atoms setforce 0.0 0.0 0.0
minimize 1.0e-4 1.0e-6 1000 10000

print "Phase 0a complete: minimization done"

# === Phase 0b: Gentle relaxation (CG frozen, nve/limit, tiny dt). AT
# intra-bead chemistry is always fully active (see docs/theory.md), so a
# thermostat is needed here too, not just during the ramp: fragments
# placed with local strain release that strain as real kinetic energy
# with nothing yet to damp it. ===
fix relax at_atoms nve/limit 0.01
fix therm_relax at_atoms langevin 298.0 298.0 20.0 48280

timestep 0.01
run 10000

unfix therm_relax
print "Phase 0b complete: AT overlap relaxation done"

# === Phase 1: Lambda ramp with nve/limit for all (small dt) ===
# A thermostat runs throughout the ramp (matching the original AdResS
# protocol's always-on Langevin damping — Krajniak et al. JCTC 2016), so
# transient force spikes from AT interactions turning on are removed as
# heat instead of accumulating as runaway kinetic energy.
unfix relax
unfix freeze

fix limit_all all nve/limit 0.05
fix therm_ramp at_atoms langevin 298.0 298.0 100.0 48291
fix_modify bm active yes

timestep 0.10
run 20000

print "Phase 1 complete: lambda ramp done"

# === Phase 2: Switch to NVT equilibration ===
unfix limit_all
unfix therm_ramp

fix integrate at_atoms nvt temp 298.0 298.0 100.0
fix cg_nvt cg_atoms nvt temp 298.0 298.0 100.0

timestep 0.25
run 10000

timestep 0.50
run 5000

timestep 1.00
run 5000

write_data dodecane_hybrid.data

print "Backmapping complete. Run extract_at_frame.py to get pure AT data."
