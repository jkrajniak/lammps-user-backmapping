angle_coeff 44 backmap/harmonic at 170.000188 124.5850
angle_coeff 45 backmap/table cg table_a1.table ENTRY

dihedral_style hybrid ryckaert harmonic backmap/ryckaert backmap/table linear 1000
dihedral_coeff 1 ryckaert 0.150000 -0.450000 0.000000 0.600001 0.000000 -0.000000
dihedral_coeff 2 ryckaert -0.105999 -0.916002 0.173999 0.984000 0.000000 -0.000000
dihedral_coeff 3 ryckaert 0.233999 -0.701999 0.000000 0.936000 0.000000 -0.000000
dihedral_coeff 4 ryckaert 0.225000 -0.675001 0.000000 0.900001 0.000000 -0.000000
dihedral_coeff 5 ryckaert 4.533005 4.533005 0.000000 -0.000000 0.000000 -0.000000
dihedral_coeff 6 ryckaert 7.250008 -0.000000 -7.250008 -0.000000 0.000000 -0.000000
dihedral_coeff 7 harmonic 1.100001 -1 2
dihedral_coeff 8 ryckaert 5.000006 -0.000000 -5.000006 -0.000000 0.000000 -0.000000
dihedral_coeff 9 backmap/table cg table_d0.table ENTRY
dihedral_coeff 10 backmap/table cg table_d1.table ENTRY
dihedral_coeff 11 backmap/ryckaert at 2.100002 -0.000000 -2.100002 -0.000000 0.000000 -0.000000
dihedral_coeff 12 harmonic 10.500012 -1 2
dihedral_coeff 13 backmap/ryckaert at 7.250008 -0.000000 -7.250008 -0.000000 0.000000 -0.000000
dihedral_coeff 14 backmap/ryckaert at 7.000008 2.000002 -5.000006 -0.000000 0.000000 -0.000000

special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

group at_atoms type 2 3 4 5 8 9 10 12 13 15 17 18
group cg_atoms type 1 6 7 11 14 16

neigh_modify delay 0 every 1 check yes

fix bm all backmap cg_type 1 6 7 11 14 16 alpha 0.0001 lambda0 0.0 nonuniform no
fix pairs all backmap/pairs at file pairs.dat cut 12.000000
fix cap all backmap/capforce 1195.0300

compute at_temp at_atoms temp

thermo 1000
thermo_style custom step temp pe ke etotal press f_bm
thermo_modify colname f_bm lambda
thermo_modify temp at_temp

dump traj all custom 1000 dump.backmap id mol type x y z f_bm
dump_modify traj sort id

# === Phase 0: minimize the whole hybrid structure at lambda=0. Intra-bead
# AT chemistry and CG-CG are both fully active (see header note), so this
# relaxes both the CG structure and each fragment's local AT geometry —
# nothing needs to be frozen. The published Dacron/PET CG-CG angle
# geometry (table_a0, type 36) sits far from its table minimum in the
# as-generated structure (real feature of the reference structure, not a
# bug — see notebook 2026-07-12_pet-angle-geometry-blowup.md), so this
# does not fully converge within the iteration budget; that residual
# strain is handled by the settle sub-stage below, not by minimize. ===
velocity all create 298.0 48279 dist gaussian mom yes rot yes
timestep 1.0
min_style fire
minimize 0.0 1.0e-4 50000 500000
print "Phase 0 complete: hybrid minimization at lambda=0 done"

# === Phase 1: CG equilibration at lambda=0 (real thermalized dynamics for
# both CG and AT; AT has real intra-molecular restoring forces so a
# constant-gamma thermostat is safe here, matching the original
# ESPResSo++ driver). Split into a tightly-damped, small-dt "settle"
# sub-stage that safely dissipates the residual minimize strain (see
# Phase 0 note above) as heat, a dt ramp-up, then the bulk equilibration
# at production dt — mirrors the dt ramp-up already used in Phase 3. ===
velocity all create 298.0 48279 dist gaussian mom yes rot yes
fix limit_settle all nve/limit 0.01
fix thermo_cg_settle cg_atoms langevin 298.0 298.0 5.0 48279
fix thermo_at_settle at_atoms langevin 298.0 298.0 5.0 48280
timestep 0.05
run 2000
unfix thermo_cg_settle
unfix thermo_at_settle
unfix limit_settle

fix limit_ramp all nve/limit 0.05
fix thermo_cg_ramp cg_atoms langevin 298.0 298.0 20.0 48279
fix thermo_at_ramp at_atoms langevin 298.0 298.0 20.0 48280
timestep 0.1
run 2000
timestep 0.25
run 2000
timestep 0.5
run 2000
timestep 0.75
run 2000
unfix thermo_cg_ramp
unfix thermo_at_ramp
unfix limit_ramp
print "Phase 1 settle/dt-ramp complete"

# nve/limit (not plain nve) throughout the bulk equilibration too: at
# dt=1.0 fs, an unbounded per-step displacement risks moving an atom
# outside its bonded partner's ghost halo in one step while residual
# minimize strain (see Phase 0 note) is still relaxing (observed as a
# "bond atoms missing" crash without this cap).
fix limit_main all nve/limit 0.1
fix thermo_cg cg_atoms langevin 298.0 298.0 100.0 48279
fix thermo_at at_atoms langevin 298.0 298.0 100.0 48280
timestep 1.0
run ${eq0_steps}
unfix limit_main
unfix thermo_cg
unfix thermo_at
print "Phase 1 complete: CG equilibration at lambda=0 done"

# === Phase 2: lambda ramp (fix backmap becomes active and drives CG via
# COM shift toward AT COM, so "all" nve/limit is a no-op for CG but keeps
# every atom under a time-integration fix, matching the validated
# rim135/dodecane pattern) ===
fix limit_all all nve/limit 0.05
fix thermo_at at_atoms langevin 298.0 298.0 66.7 48279
fix_modify bm active yes
timestep 0.10
run ${ramp_steps}
unfix limit_all
unfix thermo_at
print "Phase 2 complete: lambda ramp done"

# === Phase 3: NVT production at lambda=1 (fix backmap stays active, pinned
# at lambda=1 once the ramp saturates) ===
fix nvt_at at_atoms nvt temp 298.0 298.0 100.0
fix nvt_cg cg_atoms nvt temp 298.0 298.0 100.0
timestep 0.25
run ${prod_steps_a}
timestep 0.50
run ${prod_steps_b}
timestep 1.00
run ${prod_steps_c}

write_data pet_hybrid.data
print "Backmapping complete."
