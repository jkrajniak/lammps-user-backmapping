# Tier C: independent AT reference dodecane (500 molecules, 298 K), RDF production.
# Input: dodecane_at_ref.data from `backmap-prep at-system settings.yaml --reference 500`
# (template chains on a lattice in an expanded box).
# Force field: dodecane.at.ff.lmp, generated by backmap-prep (never restate it here).
# Required: -var L <box length, A> (the hybrid box, e.g. from dodecane.data).
# Optional: -var prod_steps N (default 5000000 = 5 ns at 1 fs).

variable        prod_steps index 5000000

units           real
atom_style      full
boundary        p p p
read_data       dodecane_at_ref.data
include         dodecane.at.ff.lmp

thermo          5000
thermo_style    custom step temp pe ke etotal ebond eangle edihed evdwl ecoul press density vol

minimize        1.0e-4 1.0e-4 500 5000
# Randomize at high T, compress to the hybrid box, relax at 1 atm, NVT.
timestep        0.5
velocity        all create 600.0 8763 mom yes rot yes dist gaussian
fix             integrate all nvt temp 600.0 600.0 100.0
run             20000
unfix           integrate
fix             integrate all nvt temp 500.0 500.0 100.0
fix             shrink all deform 1 x final 0.0 ${L} y final 0.0 ${L} z final 0.0 ${L} units box
run             100000
unfix           shrink
unfix           integrate
timestep        1.0
fix             integrate all npt temp 500.0 298.0 100.0 iso 1.0 1.0 1000.0
run             100000
unfix           integrate
fix             integrate all nvt temp 298.0 298.0 100.0
run             100000

# Production: RDFs, bonded distributions and trajectory; CH3-CH3, CH3-CH2, CH2-CH2, blocks of 200 ps
compute         rdf_ref all rdf 200 1 1 1 2 2 2
fix             rdf_out all ave/time 100 2000 200000 c_rdf_ref[*] file rdf_reference.dat mode vector
# Trajectory every 10 ps; angle and dihedral distributions per 200 ps block
dump            traj all dcd 10000 traj_reference.dcd
dump_modify     traj unwrap yes
compute         ang all angle/local theta
compute         dih all dihedral/local phi
fix             ang_hist all ave/histo 100 2000 200000 0.0 180.0 180 c_ang mode vector kind local file angle_hist_reference.dat
fix             dih_hist all ave/histo 100 2000 200000 -180.0 180.0 360 c_dih mode vector kind local file dihedral_hist_reference.dat
run             ${prod_steps}
unfix           rdf_out
unfix           ang_hist
unfix           dih_hist
undump          traj
write_data      dodecane_at_ref_final.data
