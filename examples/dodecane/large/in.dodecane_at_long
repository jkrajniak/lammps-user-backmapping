# Pure AT production for backmapped dodecane (paper-grade RDF averaging)
# Input:  dodecane_at.data (extracted from hybrid backmapped frame)
# Output: rdf_backmap_long.dat — 5 blocks of 200 ps each, 1 ns total
#
# Protocol:
#   Phase 0: minimisation (CG)
#   Phase 1: gradual NPT heating 100 K -> 298 K, 100 ps  (relax bonds/angles
#            after lambda ramp, equilibrate density)
#   Phase 2: NPT equilibration at 298 K / 1 atm, 200 ps
#   Phase 3: NVT equilibration at 298 K, 100 ps
#   Phase 4: NVT production 1 ns with RDF (5 x 200 ps averaging blocks)

units           real
atom_style      full
boundary        p p p

read_data       dodecane_at.data

pair_style      lj/cut 14.00
pair_modify     shift yes
pair_coeff      1 1 0.207266 3.748000
pair_coeff      1 2 0.156387 3.826500
pair_coeff      2 2 0.117997 3.905000

bond_style      harmonic
bond_coeff      1 800.000883 1.530000
bond_coeff      2 800.000883 1.530000

angle_style     harmonic
angle_coeff     1 126.673180 111.0000

special_bonds   lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          5000
thermo_style    custom step temp pe ke etotal press density vol

# --- Phase 0: minimisation ------------------------------------------------
minimize        1.0e-4 1.0e-4 1000 10000

reset_timestep  0
velocity        all create 100.0 4928459 mom yes rot yes dist gaussian

# --- Phase 1: gradual NPT heating 100 K -> 298 K, 100 ps ------------------
timestep        0.5
fix             integrate all npt temp 100.0 298.0 50.0 iso 1.0 1.0 500.0
run             200000
unfix           integrate

# --- Phase 2: NPT equilibration at 298 K / 1 atm, 200 ps ------------------
timestep        1.0
fix             integrate all npt temp 298.0 298.0 100.0 iso 1.0 1.0 1000.0
run             200000
unfix           integrate

# --- Phase 3: NVT equilibration at 298 K, 100 ps --------------------------
fix             integrate all nvt temp 298.0 298.0 100.0
run             100000

# --- Phase 4: production 1 ns with RDF averaging (5 x 200 ps blocks) ------
# CH3-CH3 (1-1), CH3-CH2 (1-2), CH2-CH2 (2-2)
compute         rdf_at all rdf 200 1 1 1 2 2 2
# Nevery=100, Nrepeat=2000, Nfreq=200000 -> sample every 100 fs,
# average over 200 ps, dump 5 blocks across 1 ns production.
fix             rdf_out all ave/time 100 2000 200000 c_rdf_at[*] file rdf_backmap_long.dat mode vector

run             1000000

unfix           rdf_out
unfix           integrate
write_data      dodecane_final_long.data
