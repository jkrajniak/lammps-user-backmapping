# Tier C: backmapped PE melt as a plain AT system (423 K), RDF production.
# Input: pe_at.data from `backmap-prep at-system settings.yaml --from pe_hybrid.data`.
# Force field: pe.at.ff.lmp, generated by backmap-prep (never restate it here).
# Optional: -var prod_steps N (default 5000000 = 5 ns at 1 fs).

variable        prod_steps index 5000000

units           real
atom_style      full
boundary        p p p
read_data       pe_at.data
include         pe.at.ff.lmp

thermo          5000
thermo_style    custom step temp pe ke etotal ebond eangle edihed evdwl ecoul press density vol

# Relax the backmapped frame, then NPT at 1 atm and NVT before production.
minimize        1.0e-4 1.0e-6 1000 10000
reset_atoms     image all
reset_timestep  0
velocity        all create 423.0 4928459 mom yes rot yes dist gaussian
timestep        0.5
fix             integrate all npt temp 423.0 423.0 100.0 iso 1.0 1.0 500.0
run             200000
unfix           integrate
timestep        1.0
fix             integrate all nvt temp 423.0 423.0 100.0
run             100000

# Production: RDFs CH3-CH3, CH3-CH2, CH2-CH2, 25 blocks of 200 ps
compute         rdf_at all rdf 200 1 1 1 2 2 2
fix             rdf_out all ave/time 100 2000 200000 c_rdf_at[*] file rdf_backmap.dat mode vector
# Trajectory every 10 ps; angle and dihedral distributions per 200 ps block
dump            traj all dcd 10000 traj_backmap.dcd
dump_modify     traj unwrap yes
compute         ang all angle/local theta
compute         dih all dihedral/local phi
fix             ang_hist all ave/histo 100 2000 200000 0.0 180.0 180 c_ang mode vector kind local file angle_hist_backmap.dat
fix             dih_hist all ave/histo 100 2000 200000 -180.0 180.0 360 c_dih mode vector kind local file dihedral_hist_backmap.dat
run             ${prod_steps}
unfix           rdf_out
unfix           ang_hist
unfix           dih_hist
undump          traj
write_data      pe_at_final.data
