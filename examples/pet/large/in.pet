bond_style backmap/harmonic
bond_coeff 1 at 536.000592 1.520000
bond_coeff 2 at 680.000751 1.100000
bond_coeff 3 at 680.000751 1.090000
bond_coeff 4 at 640.000707 1.420000
bond_coeff 5 at 1106.001221 0.970000
bond_coeff 6 at 900.000994 1.350000
bond_coeff 7 at 1140.001259 1.220000
bond_coeff 8 at 938.001036 1.400000
bond_coeff 9 at 734.000810 1.090000
bond_coeff 10 at 938.001036 1.410000
bond_coeff 11 at 734.000810 1.080000
bond_coeff 12 at 1106.001221 0.980000
bond_coeff 13 at 824.570700 1.000000
bond_coeff 14 cg 65.116229 2.563950
bond_coeff 15 at 0.000000 0.000000
bond_coeff 16 cg 93.986719 3.387400
bond_coeff 17 at 800.000883 1.480000
bond_coeff 18 at 800.000883 1.500000
bond_coeff 19 cg 74.093055 3.447900

angle_style hybrid backmap/harmonic backmap/table linear 1000
angle_coeff 1 backmap/harmonic at 75.000083 110.4070
angle_coeff 2 backmap/harmonic at 75.000083 110.3880
angle_coeff 3 backmap/harmonic at 75.000083 110.4140
angle_coeff 4 backmap/harmonic at 75.000083 110.4210
