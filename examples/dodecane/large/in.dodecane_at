# Tier C: backmapped dodecane (500 molecules, 298 K) as a plain AT system, RDFs.
# Input: dodecane_at.data from
#   `backmap-prep at-system settings.yaml --from dodecane_hybrid.data`.
# Force field: dodecane.at.ff.lmp, generated by backmap-prep (never restate it).
# Optional: -var prod_steps N (default 5000000 = 5 ns at 1 fs).

variable        prod_steps index 5000000

units           real
atom_style      full
boundary        p p p
read_data       dodecane_at.data
include         dodecane.at.ff.lmp

thermo          5000
thermo_style    custom step temp pe ke etotal ebond eangle edihed evdwl ecoul press density vol

minimize        1.0e-4 1.0e-6 1000 10000
reset_atoms     image all
reset_timestep  0
velocity        all create 298.0 4928459 mom yes rot yes dist gaussian
timestep        0.5
fix             integrate all npt temp 298.0 298.0 100.0 iso 1.0 1.0 500.0
run             200000
unfix           integrate
timestep        1.0
fix             integrate all nvt temp 298.0 298.0 100.0
run             100000

# Production: RDFs CH3-CH3, CH3-CH2, CH2-CH2, blocks of 200 ps
compute         rdf_at all rdf 200 1 1 1 2 2 2
fix             rdf_out all ave/time 100 2000 200000 c_rdf_at[*] file rdf_backmap.dat mode vector
run             ${prod_steps}
unfix           rdf_out
write_data      dodecane_at_final.data
