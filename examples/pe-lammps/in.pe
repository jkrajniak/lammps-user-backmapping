# LAMMPS input for backmapping — generated by backmap-prep
# Reference: Krajniak et al., JCTC 2016, DOI: 10.1021/acs.jctc.6b00595
#            Krajniak, Zhang et al., JCC 2018, DOI: 10.1002/jcc.25129

units real
atom_style full
boundary p p p

read_data pe.data

comm_modify cutoff 15.00

pair_style backmap 14.00 lj/cut/coul/cut 14.00 9.00 14.00 table linear 1000
pair_coeff 1 1 cg table_1_1.table ENTRY
pair_coeff 1 2 cg table_1_2.table ENTRY
pair_coeff 1 3 none
pair_coeff 1 4 none
pair_coeff 2 2 cg table_2_2.table ENTRY
pair_coeff 2 3 none
pair_coeff 2 4 none
pair_coeff 3 3 atomistic 0.207266 3.748000
pair_coeff 3 4 atomistic 0.156387 3.826500
pair_coeff 4 4 atomistic 0.117997 3.905000

bond_style hybrid harmonic backmap/harmonic backmap/table linear 1000
bond_coeff 1 harmonic 316.682950 1.530000
bond_coeff 2 backmap/table cg table_b2.table ENTRY
bond_coeff 3 backmap/table cg table_b1.table ENTRY
bond_coeff 4 backmap/harmonic at 316.682950 1.530000

angle_style hybrid backmap/harmonic backmap/table linear 1000
angle_coeff 1 backmap/table cg table_a1.table ENTRY
angle_coeff 2 backmap/table cg table_a2.table ENTRY
angle_coeff 3 backmap/harmonic at 62.141560 111.0000

dihedral_style hybrid backmap/ryckaert backmap/table linear 1000
dihedral_coeff 1 backmap/table cg table_d1.table ENTRY
dihedral_coeff 2 backmap/ryckaert at 0.717018 -2.217713 2.905285 3.135783 -0.731287 -6.271589

special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

group at_atoms type 3 4
group cg_atoms type 1 2

neigh_modify delay 0 every 1 check yes

# Initial velocities at T=423.0 K
velocity all create 423.0 12345 dist gaussian mom yes rot yes

fix integrate at_atoms nve
fix thermo at_atoms langevin 423.0 423.0 33.3 12345

fix bm all backmap cg_type 1 2 alpha 0.0001 lambda0 0.0

compute at_temp at_atoms temp

timestep 1.00

thermo 1000
thermo_style custom step temp pe ke etotal press f_bm
thermo_modify colname f_bm lambda
thermo_modify temp at_temp

dump traj all custom 1000 dump.backmap id mol type x y z f_bm
dump_modify traj sort id

# Phase 1: CG equilibration (λ frozen — optional if CG was pre-equilibrated)
fix_modify bm active no
run 10000

# Phase 2: Backmapping
timestep 1.00
fix_modify bm active yes
run 10000

write_data pe_hybrid.data

# Phase 3: AT production (optional post-backmap)
timestep 1.00
run 10000

write_data pe_final.data
