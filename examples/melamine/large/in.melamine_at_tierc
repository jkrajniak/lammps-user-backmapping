special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

thermo 5000
thermo_style custom step temp pe ke etotal press density vol

# --- Phase 0: minimisation ------------------------------------------------
minimize 1.0e-4 1.0e-6 500 5000
reset_timestep 0
velocity all create 300.0 4928459 mom yes rot yes dist gaussian

# --- Phase 1: NVT equilibration 300 K, 50 ps -----------------------------
timestep 1.0
fix integrate all nvt temp 300.0 300.0 100.0
run 50000

# --- Phase 2: NVT production 500 ps ----------------------------------------
dump traj all custom 5000 dump.at_prod id mol type x y z
dump_modify traj sort id
run 500000

unfix integrate
undump traj
write_data melamine_at_final.data
print "Melamine AT Tier C production complete."
