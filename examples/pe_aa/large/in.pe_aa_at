# Tier C: backmapped all-atom PE melt (423 K; carbon types 2 = CH3, 1 = CH2) as a plain AT system, RDFs and bonded distributions.
# Input: pe_aa_at.data from `backmap-prep at-system settings.yaml --from pe_aa_hybrid.data`.
# Force field: pe_aa.at.ff.lmp, generated by backmap-prep (never restate it here).
# Optional: -var prod_steps N (default 5000000 = 5 ns at 1 fs).
#           -var npt_steps 200000 (0.5 fs), -var nvt_steps 100000 (1 fs) before the production.
#
# Resumable (spot or preemptible machines). Every stage runs to an absolute end step
# (`run N upto`) and a restart file is written every `ckpt` steps. To continue an interrupted run:
#   -var resume 1 -var resume_file <restart file> -var seg <segment number>
# scripts/review/resumable_lmp.sh does this and merges the per-segment files at the end
# (rdf_backmap.dat, angle_hist_backmap.dat, dihedral_hist_backmap.dat). Keep `ckpt` a multiple
# of `block` (the averaging block, 200 ps by default) so that a restart starts a complete block.
#   -var block 200000  -var ckpt 200000  -var thermo_every 5000

variable        prefix index pe_aa
variable        T index 423.0
variable        tA index 2
variable        tB index 1
variable        prod_steps index 5000000
variable        npt_steps index 200000
variable        nvt_steps index 100000
variable        block index 200000
variable        ckpt index 200000
variable        thermo_every index 5000
variable        seg index 1
variable        resume index 0
variable        resume_file index none

units           real
atom_style      full
boundary        p p p
if "${resume} == 0" then "read_data ${prefix}_at.data" else "read_restart ${resume_file}"
include         ${prefix}.at.ff.lmp

thermo          ${thermo_every}
thermo_style    custom step temp pe ke etotal ebond eangle edihed evdwl ecoul press density vol
thermo_modify   flush yes
restart         ${ckpt} rst.s${seg}.a rst.s${seg}.b

if "${resume} == 1" then "jump SELF resume"

# Relax the backmapped frame, then NPT at 1 atm and NVT before production.
minimize        1.0e-4 1.0e-6 1000 10000
reset_atoms     image all
reset_timestep  0
velocity        all create ${T} 4928459 mom yes rot yes dist gaussian

label           resume
variable        E1 equal ${npt_steps}
variable        E2 equal v_E1+${nvt_steps}
variable        E3 equal v_E2+${prod_steps}
variable        nrep equal ${block}/100

label           npt
if "$(step) >= ${E1}" then "jump SELF nvt"
timestep        0.5
fix             integrate all npt temp ${T} ${T} 100.0 iso 1.0 1.0 500.0
run             ${E1} upto
unfix           integrate

label           nvt
if "$(step) >= ${E2}" then "jump SELF prod"
timestep        1.0
fix             integrate all nvt temp ${T} ${T} 100.0
run             ${E2} upto
unfix           integrate

# Production: carbon RDFs CH3-CH3, CH3-CH2, CH2-CH2, bonded distributions and trajectory
label           prod
if "$(step) >= ${E3}" then "jump SELF finish"
timestep        1.0
fix             integrate all nvt temp ${T} ${T} 100.0
group           carbon type ${tA} ${tB}
compute         rdf_at all rdf 200 ${tA} ${tA} ${tA} ${tB} ${tB} ${tB}
fix             rdf_out all ave/time 100 ${nrep} ${block} c_rdf_at[*] file rdf_backmap.s${seg}.dat mode vector
dump            traj all dcd 10000 traj_backmap.s${seg}.dcd
dump_modify     traj unwrap yes
compute         ang carbon angle/local theta
compute         dih carbon dihedral/local phi
fix             ang_hist all ave/histo 100 ${nrep} ${block} 0.0 180.0 180 c_ang mode vector kind local file angle_hist_backmap.s${seg}.dat
fix             dih_hist all ave/histo 100 ${nrep} ${block} -180.0 180.0 360 c_dih mode vector kind local file dihedral_hist_backmap.s${seg}.dat
run             ${E3} upto
unfix           rdf_out
unfix           ang_hist
unfix           dih_hist
undump          traj
unfix           integrate

label           finish
write_data      ${prefix}_at_final.data
