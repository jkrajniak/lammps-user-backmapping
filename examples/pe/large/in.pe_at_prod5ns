# Continue backmapped PE melt — 5 ns RDF production.
# Input: pe_at_final.data (after in.pe_at)
# Output: rdf_backmap_5ns.dat (25 x 200 ps blocks)

units           real
atom_style      full
boundary        p p p

pair_style      lj/cut 14.00
bond_style      harmonic
angle_style     harmonic
dihedral_style  ryckaert

read_data       pe_at_final.data

pair_modify     shift yes
pair_coeff      1 1 0.207266 3.748000
pair_coeff      1 2 0.156387 3.826500
pair_coeff      2 2 0.117997 3.905000

bond_coeff      1 633.365900 1.530000
bond_coeff      2 633.365900 1.530000

angle_coeff     1 124.283120 111.0000

dihedral_coeff  1 0.717018 -2.217713 2.905285 3.135783 -0.731287 -6.271589

special_bonds   lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          5000
thermo_style    custom step temp pe ke etotal press density vol

timestep        1.0
reset_timestep  0
velocity        all create 423.0 4928459 mom yes rot yes dist gaussian

# Brief NVT re-equilibration (50 ps)
fix             integrate all nvt temp 423.0 423.0 100.0
run             50000
unfix           integrate

# Production 5 ns — 25 blocks x 200 ps
compute         rdf_at all rdf 200 1 1 1 2 2 2
fix             integrate all nvt temp 423.0 423.0 100.0
fix             rdf_out all ave/time 100 2000 200000 c_rdf_at[*] file rdf_backmap_5ns.dat mode vector
run             5000000

unfix           rdf_out
unfix           integrate
write_data      pe_at_final_5ns.data
