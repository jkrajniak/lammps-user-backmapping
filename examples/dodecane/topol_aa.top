; Dodecane, GROMOS 53a6 united atom: the model of the published data set
; (Krajniak et al., JCTC 2016, doi:10.1021/acs.jctc.6b00595, bundle
; preparation/dodecane/atomistic/nvt/dodecane.itp with gromos53a6.ff), to which
; the CG model (IBI tables) was fitted. Self-contained: the parameters are those
; of `gmx grompp -pp` (GROMACS 2026) on that topology, restricted to CH2/CH3.
;   bonds  func 2 (G96 quartic, gb_27), angles func 2 (G96, ga_15),
;   dihedrals func 1 (gd_34), 1-4 [ pairs ] from [ pairtypes ] (gen-pairs no).

[ defaults ]
; nbfunc  comb-rule  gen-pairs  fudgeLJ  fudgeQQ
  1        1          no         1.0      1.0

[ atomtypes ]
; name  mass     charge  ptype  c6            c12
  CH2    14.027   0.000   A      0.0074684164  3.3965584e-05
  CH3    15.035   0.000   A      0.0096138025  2.6646244e-05

[ nonbond_params ]
; i    j    func  c6           c12
  CH3  CH2  1     0.008473481  3.0084136e-05

[ pairtypes ]
; i    j    func  c6            c12
  CH2  CH2  1     0.0047238129  4.7419261e-06
  CH3  CH2  1     0.0056894694  5.347702e-06
  CH3  CH3  1     0.0068525284  6.0308652e-06

[ moleculetype ]
; Name            nrexcl
DOD             3

