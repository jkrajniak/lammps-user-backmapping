# Bounded AT-fragment force-field script (coefficients as exact doubles of
# the topol_aa.top values converted to real units) for the PE (polyethylene) AT
# reference, converted directly from pe_single.gro/topol_aa.top (NOT
# extracted from a built hybrid -- see design.md correction note on why
# hybrid-extraction is wrong for AT-fragment templates, unlike the CG side).

units real
atom_style full

pair_style lj/cut 14.00
pair_coeff 1 1 0.20726577437858507 3.748
pair_coeff 2 2 0.11799713193116634 3.9050000000000002

bond_style harmonic
bond_coeff 1 316.6826003824092 1.53

angle_style harmonic
angle_coeff 1 62.141491395793494 111.0

dihedral_style ryckaert
dihedral_coeff 1 2.217710325047801 -2.905282026768642 -3.1357791586998087 0.7312858508604205 6.271582217973231 3.22538240917782
