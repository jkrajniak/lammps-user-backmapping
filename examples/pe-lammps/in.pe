# LAMMPS input for backmapping — generated by backmap-prep
# Reference: Krajniak et al., JCTC 2016, DOI: 10.1021/acs.jctc.6b00595
#            Krajniak, Zhang et al., JCC 2018, DOI: 10.1002/jcc.25129

units real
atom_style full
boundary p p p

read_data pe.data

include pe.ff.lmp

# Initial velocities at T=423.0 K
velocity all create 423.0 12345 dist gaussian mom yes rot yes

fix integrate at_atoms nve
fix thermo at_atoms langevin 423.0 423.0 33.3 12345

include pe.backmap.lmp

reset_atoms image all

compute at_temp at_atoms temp

timestep 1.00

thermo 1000
thermo_style custom step temp pe ke etotal press f_bm
thermo_modify colname f_bm lambda
thermo_modify temp at_temp

dump traj all custom 1000 dump.backmap id mol type x y z f_bm
dump_modify traj sort id

# Phase 1: CG equilibration (λ frozen — optional if CG was pre-equilibrated)
fix_modify bm active no
run 10000

# Phase 2: Backmapping
timestep 1.00
fix_modify bm active yes
run 10000

write_data pe_hybrid.data

# Phase 3: AT production (optional post-backmap)
timestep 1.00
run 10000

write_data pe_final.data
