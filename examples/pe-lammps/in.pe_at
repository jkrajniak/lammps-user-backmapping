# Bounded AT-fragment force-field script for the PE (polyethylene) AT
# reference, converted directly from pe_single.gro/topol_aa.top (NOT
# extracted from a built hybrid -- see design.md correction note on why
# hybrid-extraction is wrong for AT-fragment templates, unlike the CG side).

units real
atom_style full

pair_style lj/cut 14.00
pair_coeff 1 1 0.207266 3.748000
pair_coeff 2 2 0.117997 3.905000

bond_style harmonic
bond_coeff 1 316.682950 1.530000

angle_style harmonic
angle_coeff 1 62.141560 111.0000

dihedral_style ryckaert
dihedral_coeff 1 2.217713 -2.905285 -3.135783 0.731287 6.271589 3.225386
