# LAMMPS input for backmapping — generated by backmap-prep
# Reference: Krajniak et al., JCTC 2016, DOI: 10.1021/acs.jctc.6b00595
#            Krajniak, Zhang et al., JCC 2018, DOI: 10.1002/jcc.25129

units real
atom_style full
boundary p p p

read_data dodecane.data

include dodecane.ff.lmp

include dodecane.backmap.lmp

reset_atoms image all

compute at_temp at_atoms temp
thermo 1000
thermo_style custom step temp pe ke etotal ebond eangle edihed evdwl ecoul press f_bm
thermo_modify colname f_bm lambda temp at_temp

dump traj all custom 1000 dump.backmap id mol type x y z f_bm
dump_modify traj sort id

# Phase 0a: minimize AT overlaps at lambda = 0 (CG frozen)
fix freeze cg_atoms setforce 0.0 0.0 0.0
minimize 1.0e-4 1.0e-6 1000 10000

# Phase 0b: relax AT fragments at lambda = 0 (CG frozen)
fix relax at_atoms nve/limit 0.01
fix therm_relax at_atoms langevin 298.0 298.0 20.0 12346
timestep 0.01
run 10000
unfix therm_relax
unfix relax
unfix freeze

# Phase 1: lambda ramp 0 -> 1 (20000 steps at 0.1 fs, alpha 0.0001)
fix limit_all all nve/limit 0.05
fix therm_ramp at_atoms langevin 298.0 298.0 100.0 12347
fix_modify bm active yes
timestep 0.10
run 20000
unfix limit_all
unfix therm_ramp

# Phase 2: NVT at lambda = 1, staged timestep
fix nvt_at at_atoms nvt temp 298.0 298.0 100.0
fix nvt_cg cg_atoms nvt temp 298.0 298.0 100.0
timestep 0.25
run 10000
timestep 0.50
run 5000
timestep 1.00
run 5000

write_data dodecane_hybrid.data
