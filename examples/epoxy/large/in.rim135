dihedral_style hybrid ryckaert harmonic backmap/ryckaert
dihedral_coeff 1 ryckaert 0.380000 -1.140001 0.000000 1.520002 0.000000 -0.000000
dihedral_coeff 2 ryckaert 0.410000 -0.680001 0.250000 1.340001 0.000000 -0.000000
dihedral_coeff 3 ryckaert 0.150000 -0.450000 0.000000 0.600001 0.000000 -0.000000
dihedral_coeff 4 ryckaert 0.687001 -0.139001 0.500001 1.326003 0.000000 -0.000000
dihedral_coeff 5 ryckaert 0.233999 -0.701999 0.000000 0.936000 0.000000 -0.000000
dihedral_coeff 6 ryckaert -0.275000 -0.275000 0.000000 -0.000000 0.000000 -0.000000
dihedral_coeff 7 ryckaert 7.250008 -0.000000 -7.250008 -0.000000 0.000000 -0.000000
dihedral_coeff 8 ryckaert 0.000000 -0.000000 0.000000 -0.000000 0.000000 -0.000000
dihedral_coeff 9 ryckaert 0.230999 -0.693000 0.000000 0.924000 0.000000 -0.000000
dihedral_coeff 10 ryckaert -0.105999 -0.916002 0.173999 0.984000 0.000000 -0.000000
dihedral_coeff 11 ryckaert 2.159500 2.159500 0.000000 -0.000000 0.000000 -0.000000
dihedral_coeff 12 ryckaert 0.225000 -0.675001 0.000000 0.900001 0.000000 -0.000000
dihedral_coeff 13 harmonic 15.000017 -1 2
dihedral_coeff 14 ryckaert 0.700001 0.350000 0.050000 0.400000 0.000000 -0.000000
dihedral_coeff 15 ryckaert 0.797001 0.370999 0.673999 1.100001 0.000000 -0.000000
dihedral_coeff 16 ryckaert -0.979002 -1.216003 0.708999 0.946000 0.000000 -0.000000
dihedral_coeff 17 ryckaert -0.303000 -0.722001 0.417001 0.836000 0.000000 -0.000000
dihedral_coeff 18 ryckaert 0.200000 -0.600001 0.000000 0.800001 0.000000 -0.000000
dihedral_coeff 19 backmap/ryckaert at 0.410000 -0.680001 0.250000 1.340001 0.000000 -0.000000
dihedral_coeff 20 backmap/ryckaert at 0.380000 -1.140001 0.000000 1.520002 0.000000 -0.000000
dihedral_coeff 21 backmap/ryckaert at 3.000003 -0.000000 -3.000003 -0.000000 0.000000 -0.000000
dihedral_coeff 22 backmap/ryckaert at 7.250008 -0.000000 -7.250008 -0.000000 0.000000 -0.000000
dihedral_coeff 23 backmap/ryckaert at 0.687001 -0.139001 0.500001 1.326003 0.000000 -0.000000
dihedral_coeff 24 backmap/ryckaert at 0.233999 -0.701999 0.000000 0.936000 0.000000 -0.000000

special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

group at_atoms type 2 3 4 5 7 8 9 10 11 12 13 16 18 19 20 21
group cg_atoms type 1 6 14 15 17

neigh_modify delay 0 every 1 check yes

# Initial velocities at T=298.0 K
velocity all create 298.0 48279 dist gaussian mom yes rot yes

fix bm all backmap cg_type 1 6 14 15 17 alpha 0.0001 lambda0 0.0 nonuniform no
fix pairs all backmap/pairs at file pairs.dat cut 12.000000
fix cap all backmap/capforce 1195.0300

compute at_temp at_atoms temp

thermo 1000
thermo_style custom step temp pe ke etotal press f_bm
thermo_modify colname f_bm lambda
thermo_modify temp at_temp

dump traj all custom 1000 dump.backmap id mol type x y z f_bm
dump_modify traj sort id

# === Phase 0a: Minimize AT overlaps (CG frozen) ===
fix freeze cg_atoms setforce 0.0 0.0 0.0
minimize 1.0e-4 1.0e-6 1000 10000
print "Phase 0a complete: minimization done"

# === Phase 0b: Gentle AT relaxation (CG frozen, nve/limit, tiny dt) ===
fix relax at_atoms nve/limit 0.01
timestep 0.01
run 10000
unfix relax
print "Phase 0b complete: AT overlap relaxation done"

# === Phase 1: Lambda ramp (small dt, thermostat active throughout) ===
unfix freeze
fix limit_all all nve/limit 0.05
fix therm_ramp at_atoms langevin 298.0 298.0 66.7 48291
fix_modify bm active yes
timestep 0.10
run 20000
unfix limit_all
unfix therm_ramp
print "Phase 1 complete: lambda ramp done"

write_data rim135_hybrid.data

# === Phase 2: NVT production with gradual dt ramp-up ===
fix integrate at_atoms nvt temp 298.0 298.0 100.0
fix cg_nvt cg_atoms nvt temp 298.0 298.0 100.0

timestep 0.25
run 10000
timestep 0.50
run 5000
timestep 1.00
run 5000

write_data rim135_final.data
print "Backmapping complete."
