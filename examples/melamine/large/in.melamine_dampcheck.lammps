# Diagnostic continuation run: same lambda=1 production state as
# melamine_hybrid_final.data (end of the validated uncap production run,
# research/experiments/20260802_melamine-bakery-rerun.md, 2026-08-05
# update), but with fix therm_at's Langevin damping constant raised 10x
# (33.3fs -> 333.3fs) to test the MD-methodology panel hypothesis that the
# original damp value -- copied byte-for-byte from PET's in.pet, sitting
# close to the ring C-N bond's own ~25fs natural period -- under-samples
# oscillator variance (ring_angle_variance_check.py measured the ring
# C-N-C angle fluctuation at only 34% of the equipartition prediction).
#
# fix_backmap's post_force force-redistribution to AT atoms was source-
# verified (backmap_lambda_weights.h, pair_backmap.cpp) to contribute
# exactly zero force at lambda_global=1 (CG-CG pairs are skipped entirely,
# not just weighted small, once lambda saturates) -- so this run keeps
# fix bm active with lambda0=1.0 fixed throughout (no ramp) purely for its
# harmless COM-tracking/CG-position bookkeeping, isolating the damping
# constant as the only changed variable versus the validated production
# script (in.melamine_bakery_faithful.lammps, Stage 3 block).
#
# Usage: lmp -in in.melamine_dampcheck.lammps -var test_steps 30000

variable test_steps index 30000

units real
atom_style full
boundary p p p

read_data melamine_hybrid_final.data
reset_atoms image all

comm_modify cutoff 90.00

# Byte-identical to in.melamine_bakery_faithful.lammps Stage 3 (coul_cap_radius=0.0)
pair_style backmap 14.00 lj/cut/coul/cut/ecap 14.00 9.00 0.5 0.0 14.00 table linear 1000
pair_coeff 1 1 cg table_A_A.table ENTRY
pair_coeff 1 2 none
pair_coeff 1 3 none
pair_coeff 1 4 none
pair_coeff 1 5 none
pair_coeff 1 6 none
pair_coeff 1 7 none
pair_coeff 1 8 none
pair_coeff 1 9 none
pair_coeff 2 2 atomistic 0.170000 3.250000
pair_coeff 2 3 atomistic 0.109087 3.400000
pair_coeff 2 4 atomistic 0.170000 3.250000
pair_coeff 2 5 atomistic 0.105924 3.375000
pair_coeff 2 6 atomistic 0.000000 0.000000
pair_coeff 2 7 atomistic 0.170000 3.185000
pair_coeff 2 8 atomistic 0.071414 2.875000
pair_coeff 2 9 atomistic 0.000000 0.000000
pair_coeff 3 3 atomistic 0.070000 3.550000
pair_coeff 3 4 atomistic 0.109087 3.400000
pair_coeff 3 5 atomistic 0.067970 3.525000
pair_coeff 3 6 atomistic 0.000000 0.000000
pair_coeff 3 7 atomistic 0.109087 3.335000
pair_coeff 3 8 atomistic 0.045826 3.025000
pair_coeff 3 9 atomistic 0.000000 0.000000
pair_coeff 4 4 atomistic 0.170000 3.250000
pair_coeff 4 5 atomistic 0.105924 3.375000
pair_coeff 4 6 atomistic 0.000000 0.000000
pair_coeff 4 7 atomistic 0.170000 3.185000
pair_coeff 4 8 atomistic 0.071414 2.875000
pair_coeff 4 9 atomistic 0.000000 0.000000
pair_coeff 5 5 atomistic 0.065999 3.500000
pair_coeff 5 6 atomistic 0.000000 0.000000
pair_coeff 5 7 atomistic 0.105924 3.310000
pair_coeff 5 8 atomistic 0.044497 3.000000
pair_coeff 5 9 atomistic 0.000000 0.000000
pair_coeff 6 6 atomistic 0.000000 0.000000
pair_coeff 6 7 atomistic 0.000000 0.000000
pair_coeff 6 8 atomistic 0.000000 0.000000
pair_coeff 6 9 atomistic 0.000000 0.000000
pair_coeff 7 7 atomistic 0.170000 3.120000
pair_coeff 7 8 atomistic 0.071414 2.810000
pair_coeff 7 9 atomistic 0.000000 0.000000
pair_coeff 8 8 atomistic 0.030000 2.500000
pair_coeff 8 9 atomistic 0.000000 0.000000
pair_coeff 9 9 atomistic 0.000000 0.000000

bond_style hybrid harmonic backmap/harmonic backmap/table linear 1000
bond_coeff 1 harmonic 481.000531 1.350000
bond_coeff 2 harmonic 481.000531 1.370000
bond_coeff 3 harmonic 382.000422 1.470000
bond_coeff 4 harmonic 434.000479 1.010000
bond_coeff 5 harmonic 320.000353 1.430000
bond_coeff 6 harmonic 340.000375 1.100000
bond_coeff 7 harmonic 553.000611 0.980000
bond_coeff 8 harmonic 553.000611 0.970000
bond_coeff 9 backmap/table cg table_b1.table ENTRY
bond_coeff 10 backmap/harmonic at 481.000531 1.350000
bond_coeff 11 backmap/harmonic at 481.000531 1.360000

angle_style hybrid harmonic backmap/harmonic
angle_coeff 1 harmonic 80.000088 115.9740
angle_coeff 2 harmonic 50.000055 122.7480
angle_coeff 3 harmonic 35.000039 117.1410
angle_coeff 4 harmonic 80.000088 112.2030
angle_coeff 5 harmonic 35.000039 109.7990
angle_coeff 6 harmonic 35.000039 110.3940
angle_coeff 7 harmonic 80.000088 116.1820
angle_coeff 8 harmonic 50.000055 123.0140
angle_coeff 9 harmonic 35.000039 117.6650
angle_coeff 10 harmonic 80.000088 112.1460
angle_coeff 11 harmonic 35.000039 110.3040
angle_coeff 12 harmonic 35.000039 109.9090
angle_coeff 13 harmonic 80.000088 118.7940
angle_coeff 14 harmonic 50.000055 123.0660
angle_coeff 15 harmonic 35.000039 117.2970
angle_coeff 16 harmonic 80.000088 112.5740
angle_coeff 17 harmonic 35.000039 109.7450
angle_coeff 18 harmonic 35.000039 110.2540
angle_coeff 19 harmonic 35.000039 116.4310
angle_coeff 20 harmonic 55.000061 107.8310
angle_coeff 21 harmonic 35.000039 107.8120
angle_coeff 22 harmonic 35.000039 108.1410
angle_coeff 23 harmonic 33.000036 108.3770
angle_coeff 24 harmonic 35.000039 116.7990
angle_coeff 25 harmonic 55.000061 108.8060
angle_coeff 26 harmonic 35.000039 107.8650
angle_coeff 27 harmonic 35.000039 107.9800
angle_coeff 28 harmonic 33.000036 108.2970
angle_coeff 29 harmonic 35.000039 116.9500
angle_coeff 30 harmonic 55.000061 107.5770
angle_coeff 31 harmonic 35.000039 108.1470
angle_coeff 32 harmonic 35.000039 107.7610
angle_coeff 33 harmonic 33.000036 108.4640
angle_coeff 34 backmap/harmonic at 80.000088 125.0100
angle_coeff 35 backmap/harmonic at 80.000088 116.1640
angle_coeff 36 backmap/harmonic at 80.000088 125.2370
angle_coeff 37 backmap/harmonic at 40.000044 114.8430
angle_coeff 38 backmap/harmonic at 40.000044 114.8070
angle_coeff 39 backmap/harmonic at 80.000088 118.7880
angle_coeff 40 backmap/harmonic at 80.000088 124.9860
angle_coeff 41 backmap/harmonic at 40.000044 115.1170
angle_coeff 42 backmap/harmonic at 80.000088 118.8230

dihedral_style hybrid ryckaert backmap/ryckaert
dihedral_coeff 1 ryckaert 7.936008 -0.000000 -7.936008 -0.000000 0.000000 -0.000000
dihedral_coeff 2 ryckaert 4.900005 -0.000000 -4.900005 -0.000000 0.000000 -0.000000
dihedral_coeff 3 ryckaert 6.089008 -0.000000 -6.089008 -0.000000 0.000000 -0.000000
dihedral_coeff 4 ryckaert 0.280000 -0.840001 0.000000 1.120001 0.000000 -0.000000
dihedral_coeff 5 ryckaert 0.200000 -0.600001 0.000000 0.800001 0.000000 -0.000000
dihedral_coeff 6 ryckaert 4.000004 -1.000001 -5.000006 -0.000000 0.000000 -0.000000
dihedral_coeff 7 ryckaert 0.225000 -0.675001 0.000000 0.900001 0.000000 -0.000000
dihedral_coeff 8 backmap/ryckaert at 0.717018 -7.239009 -1.150001 6.089008 0.000000 -0.000000
dihedral_coeff 9 backmap/ryckaert at 0.717018 -7.936008 0.000000 7.936008 0.000000 -0.000000
dihedral_coeff 10 backmap/ryckaert at 0.717018 -4.900005 0.000000 4.900005 0.000000 -0.000000

special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

group at_atoms type 2 3 4 5 6 7 8 9
group cg_atoms type 1

neigh_modify delay 0 every 1 check yes

# Velocities already present in melamine_hybrid_final.data (no bakery
# re-seed needed -- continuing the actual production trajectory's momenta).

fix integrate_at at_atoms nve
# Only change vs. the validated production script: damp 33.3fs -> 333.3fs (10x).
fix therm_at at_atoms langevin 300.0 300.0 333.3 12345

# lambda0=1.0, ramp left inactive: fix_backmap's CG-CG coupling is already
# source-confirmed to contribute exactly zero force to AT atoms once
# lambda_global=1 (compute_weight3 gives w=1-1=0 exactly, is_almost_zero()
# skips the interaction in pair_backmap.cpp before any force is computed) --
# this fix stays on purely for its harmless COM-tracking bookkeeping.
fix bm all backmap cg_type 1 alpha 0.0001 lambda0 1.0
fix cap all backmap/capforce 1195.0300
fix_modify bm active no

compute at_temp at_atoms temp
compute cg_temp cg_atoms temp

thermo 500
thermo_style custom step temp c_at_temp c_cg_temp pe epair ebond eangle edihed f_bm f_cap f_cap[2]
thermo_modify colname f_bm lambda
thermo_modify colname f_cap ncapped
thermo_modify colname f_cap[2] Fobs
thermo_modify temp at_temp
thermo_modify lost ignore

dump traj at_atoms custom 500 dump.at_prod_dampcheck id mol type x y z
dump_modify traj sort id

timestep 1.00

run ${test_steps}
print "DAMPCHECK done step=$(step) T=$(c_at_temp) lambda=$(f_bm) Ebond=$(ebond) Eangle=$(eangle)"
