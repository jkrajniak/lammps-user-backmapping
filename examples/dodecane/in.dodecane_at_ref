# Standalone atomistic reference simulation for dodecane
# GROMOS united-atom force field (CH3/CH2)
# Produces reference RDF for comparison with backmapped system
#
# This is an INDEPENDENT AT simulation — no connection to backmapping.
# Molecules are placed on a lattice and equilibrated from scratch.
#
# Prerequisites:
#   uv run build_at_reference.py --gro dodecane_single.gro --output dodecane_at_ref.data

units real
atom_style full
boundary p p p

# Styles must be defined before read_data (data file contains coefficients)
pair_style lj/cut 14.00
pair_modify shift yes
bond_style harmonic
angle_style harmonic

read_data dodecane_at_ref.data

special_bonds lj 0.0 0.0 0.0

neighbor 2.0 bin
neigh_modify every 10 delay 0 check yes

# --- Phase A: soft push at high T to remove lattice overlaps ---
timestep 0.5
fix integrate all nvt temp 600.0 600.0 100.0

thermo 1000
thermo_style custom step temp pe ke etotal press density

run 20000

# --- Phase B: cool down to target temperature ---
unfix integrate
fix integrate all nvt temp 600.0 298.0 100.0
timestep 1.0

run 30000

# --- Phase C: equilibrate at target temperature ---
unfix integrate
fix integrate all nvt temp 298.0 298.0 100.0

run 50000

# --- Phase D: production with RDF ---
# CH3-CH3 (1-1), CH3-CH2 (1-2), CH2-CH2 (2-2)
compute rdf_ref all rdf 200 1 1 1 2 2 2
fix rdf_out all ave/time 10 100 1000 c_rdf_ref[*] file rdf_reference.dat mode vector

run 100000

write_data dodecane_at_equil.data
